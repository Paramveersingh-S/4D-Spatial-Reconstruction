# ──────────────────────────────────────────────
# Application Settings
# ──────────────────────────────────────────────
APP_NAME="The Impossible Drone Camera - 4RC API"
APP_VERSION="1.0.0"
DEBUG=true
LOG_LEVEL=INFO

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ──────────────────────────────────────────────
# Firebase / Google Cloud
# ──────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=impossible-camera-dev
FIREBASE_CREDENTIALS_PATH=firebase-adminsdk.json
FIREBASE_STORAGE_BUCKET=impossible-camera-dev.appspot.com

# ──────────────────────────────────────────────
# Storage
# ──────────────────────────────────────────────
# Set to true for local development without Firebase
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=./storage
TEMP_DIR=./temp

# ──────────────────────────────────────────────
# Upload Limits
# ──────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ──────────────────────────────────────────────
# AI Model Configuration
# ──────────────────────────────────────────────
MODEL_NAME=Luo-Yihang/4RC
# Use "cuda" for GPU inference, "cpu" for CPU (slower)
MODEL_DEVICE=cpu
MODEL_CACHE_DIR=./.model_cache
FRAME_SAMPLE_RATE=5
MAX_FRAMES=100
POINT_CLOUD_DENSITY=0.5
TARGET_RESOLUTION=512

# ──────────────────────────────────────────────
# Firebase Emulator (for local development)
# ──────────────────────────────────────────────
USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=localhost:8080
